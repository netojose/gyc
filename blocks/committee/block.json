{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gyc/committee",
	"version": "0.1.0",
	"title": "Committee",
	"category": "widgets",
	"icon": "groups",
	"description": "Team members four per row with photo, name, role, country and optional email and Instagram",
	"example": {},
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": "Executive committee"
		},
		"text": {
			"type": "string",
			"default": "The committee is responsible for organising and running GYC Europe. Its members are young professionals and students serving as volunteers."
		},
		"members": {
			"type": "array",
			"default": [
				{
					"id": 1,
					"photo": "",
					"name": "Full name",
					"role": "President",
					"country": "Country",
					"email": "",
