{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gyc/image-hero",
	"version": "0.1.0",
	"title": "Image Hero",
	"category": "widgets",
	"icon": "format-image",
	"description": "Page intro with title and text on a dark blue background, with an optional photo behind",
	"example": {},
	"attributes": {
		"image": {
			"type": "string",
			"default": ""
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": "About GYC Europe"
		},
		"titleHighlight": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": "A movement of young Adventists across Europe, gathered around the Word of God and sent to share Jesus where they live."
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false
	},
	"textdomain": "gyc/image-hero",
	"editorScript": "file:../../build/image-hero.js",
	"editorStyle": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
