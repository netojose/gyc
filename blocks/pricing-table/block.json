{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gyc/pricing-table",
	"version": "0.1.0",
	"title": "Pricing Table",
	"category": "widgets",
	"icon": "tickets",
	"description": "Mint registration section with price boxes, one optionally highlighted with a badge",
	"example": {},
	"attributes": {
		"title": {
			"type": "string",
			"default": "Ready to stand fast?"
		},
		"headline": {
			"type": "string",
			"default": "Don't miss this opportunity to be part of something greater. Register today and join over 700 young people from across Europe committed to standing fast in faith."
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
					},
					"title": {
						"type": "string"
					},
					"badge": {
						"type": "string"
					},
					"price": {
						"type": "number"
					},
					"date": {
						"type": "string"
					},
					"link": {
						"type": "string"
					}
				}
			}
		},
		"buttonLabel": {
			"type": "string",
			"default": "Register now"
		},
		"contactText": {
			"type": "string",
			"default": ""
		},
		"contactLinkLabel": {
			"type": "string",
			"default": "Still have questions? Give a look to our FAQ's page"
		},
		"contactLinkUrl": {
			"type": "string",
			"default": "/faq/"
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"color": {
			"background": true
		}
	},
	"textdomain": "gyc/pricing-table",
	"editorScript": "file:../../build/pricing-table.js",
	"editorStyle": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
