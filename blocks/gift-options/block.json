					"buttonLabel": "Ask for bank details",
					"buttonUrl": "/contact-us/"
				},
				{
					"id": 2,
					"icon": "",
					"title": "Sponsor a delegate",
					"text": "Cover the full registration of a young person from another country.",
					"buttonLabel": "",
					"buttonUrl": ""
				},
				{
					"id": 3,
					"icon": "",
					"title": "Partner with us",
					"text": "Churches and organisations can partner with GYC Europe for events and projects.",
					"buttonLabel": "",
					"buttonUrl": ""
				}
			],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
