{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gyc/event-hero",
	"version": "0.1.0",
	"title": "Event Hero",
	"category": "widgets",
	"icon": "cover-image",
	"description": "Event intro with a two-colour title, place and dates, buttons and an optional background illustration",
	"example": {},
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"image": {
			"type": "string",
			"default": ""
		},
		"eyebrow": {
			"type": "string",
			"default": "GYC Europe 2027"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"titleHighlight": {
			"type": "string",
			"default": ""
		},
		"details": {
			"type": "string",
			"default": ""
		},
		"primaryLabel": {
			"type": "string",
			"default": "Register now"
		},
		"primaryUrl": {
			"type": "string",
			"default": "#register"
		},
		"secondaryLabel": {
			"type": "string",
			"default": ""
		},
		"secondaryUrl": {
			"type": "string",
			"default": ""
		},
		"stats": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
					},
					"value": {
						"type": "string"
					},
					"label": {
						"type": "string"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"multiple": false
	},
	"textdomain": "gyc/event-hero",
	"editorScript": "file:../../build/event-hero.js",
	"editorStyle": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
