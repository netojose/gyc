{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gyc/people",
	"version": "0.1.0",
	"title": "People",
	"category": "widgets",
	"icon": "admin-users",
	"description": "Main speakers with photo cards and a bio pop-up, plus a box of workshop speakers",
	"example": {},
	"attributes": {
		"title": {
			"type": "string",
			"default": "Main speakers"
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"staffTitle": {
			"type": "string",
			"default": "Workshop speakers"
		},
		"main": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
					},
					"photo": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"role": {
						"type": "string"
					},
					"headline": {
						"type": "string"
					},
					"description": {
						"type": "string"
					}
				}
			}
		},
		"staff": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number"
					},
					"photo": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"role": {
						"type": "string"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"customCSS": false,
		"color": {
			"background": true
		}
	},
	"textdomain": "gyc/people",
	"editorScript": "file:../../build/people.js",
	"editorStyle": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
